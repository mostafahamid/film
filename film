      // ==================== تابع جستجوی دانلود ====================
      async function searchDownloadLink(title, originalTitle, quality = '') {
        const queries = [originalTitle || title, title];
        if (quality) queries.push(`${originalTitle || title} ${quality}`.trim());

        const sites = ["https://www.f2mc.top", "https://www.f2m.top", "https://digimovie.vip"];

        for (const q of queries) {
          for (const site of sites) {
            try {
              const res = await fetch(`${site}/?s=${encodeURIComponent(q)}`, {
                headers: { 'User-Agent': 'Mozilla/5.0' }
              });
              if (!res.ok) continue;
              const html = await res.text();
              const links = html.match(/https?:\/\/[^\s"'<>]+\.(?:mkv|mp4)/gi);
              if (links && links.length > 0) {
                let link = links[0].replace(/["']/g, '');
                if (!link.startsWith('http')) link = 'https://' + link;
                return { link, source: site.replace('https://', '') };
              }
            } catch (e) { continue; }
          }
        }
        return null;
      }

