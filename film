              <div class="info-item"><div class="info-label">⏱ مدت زمان</div><div class="info-value">${runtime}</div></div>
            </div>

            <div style="margin-top:28px"><h3>📝 خلاصه داستان</h3><p style="margin-top:10px;line-height:1.8;color:#ddd">${movie.overview || 'خلاصه‌ای ثبت نشده است.'}</p></div>

            <div style="margin-top:28px"><h3>🎭 عوامل فیلم</h3><div class="info-grid" style="margin-top:12px"><div class="info-item"><div class="info-label">🎬 کارگردان</div><div class="info-value">${director}</div></div><div class="info-item"><div class="info-label">👥 بازیگران اصلی</div><div class="info-value">${cast}</div></div></div></div>

            <button class="more-info-btn" onclick="toggleExtraInfo()">📖 اطلاعات بیشتر</button>
            <div id="extra-info" class="extra-info">
              <div class="info-grid">
                <div class="info-item"><div class="info-label">🌐 وبسایت رسمی</div><div class="info-value">${movie.homepage || 'ندارد'}</div></div>
                <div class="info-item"><div class="info-label">🔢 وضعیت</div><div class="info-value">${movie.status || 'نامشخص'}</div></div>
              </div>
            </div>

            <h3 style="margin-top:45px">🎬 پخش آنلاین فیلم</h3>
            <div class="player-tabs">
              <button class="player-tab active" onclick="switchPlayer('https://vidsrc.xyz/embed/movie/${imdbId}', this)">Vidsrc</button>
              <button class="player-tab" onclick="switchPlayer('https://www.2embed.cc/embed/${imdbId}', this)">2Embed</button>
              <button class="player-tab" onclick="switchPlayer('https://vidsrc.to/embed/movie/${imdbId}', this)">Vidsrc.to</button>
              <button class="player-tab" onclick="switchPlayer('https://embed.su/embed/movie/${imdbId}', this)">Embed.su</button>
            </div>
            <div class="video-container" id="player-container"><iframe src="https://vidsrc.xyz/embed/movie/${imdbId}" frameborder="0" allowfullscreen></iframe></div>
            <p style="font-size:12px;color:#888;margin-top:10px">💡 بعضی پخش‌کننده‌ها زیرنویس فارسی دارند.</p>

            <h3 style="margin-top:45px">📥 لینک‌های دانلود (چند منبع)</h3>
            <div class="download-sources">
              <a href="https://www.f2mc.top/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">f2mc.top</a>
              <a href="https://digimovie.vip/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">Digimovie</a>
              <a href="https://www.f2m.top/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">f2m.top</a>
              <a href="https://www.film2movie.asia/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">Film2Movie</a>
            </div>
          </div>

          <script>
            function switchPlayer(src, btn) {
              document.querySelectorAll('.player-tab').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              document.getElementById('player-container').innerHTML = '<iframe src="' + src + '" frameborder="0" allowfullscreen></iframe>';
            }
            function toggleExtraInfo() {
              document.getElementById('extra-info').classList.toggle('show');
            }
          </script>
        `;
        return new Response(generateHTML(content), { headers: { "Content-Type": "text/html;charset=UTF-8" } });
      }

      // ==================== صفحه سریال ====================
      if (path.startsWith("/tv/")) {
        const tvId = path.split("/")[2];
        const tmdbRes = await fetch(`${TMDB_BASE}/tv/${tvId}?api_key=${TMDB_API_KEY}&language=fa-IR&append_to_response=credits`);
        const tv = await tmdbRes.json();
        const imdbId = tv.imdb_id || tvId;

        let seasonsHtml = '';
        if (tv.seasons && tv.seasons.length > 0) {
          for (const season of tv.seasons) {
            if (season.season_number === 0) continue;
            const seasonRes = await fetch(`${TMDB_BASE}/tv/${tvId}/season/${season.season_number}?api_key=${TMDB_API_KEY}&language=fa-IR`);
            const seasonData = await seasonRes.json();

            seasonsHtml += `<div style="margin-bottom:30px"><h4 style="color:#e50914;margin-bottom:14px">فصل ${season.season_number}</h4>`;
            for (const ep of seasonData.episodes || []) {
              const embedUrl = `https://vidsrc.xyz/embed/tv/${imdbId}/${season.season_number}/${ep.episode_number}`;
              const episodeTitle = `${tv.name} S${season.season_number}E${ep.episode_number}`;
              seasonsHtml += `
                <div class="episode-container">
                  <button class="episode-btn" onclick="playEpisode('${embedUrl}', this)">▶ پخش قسمت ${ep.episode_number}</button>
                  <button class="episode-btn" style="background:#1f1f2e;border-color:#666" onclick="downloadEpisode('${episodeTitle}', '${tv.original_name}', this)">📥 دانلود</button>
                </div>`;
            }
            seasonsHtml += `</div>`;
          }
        }

        const genres = tv.genres ? tv.genres.map(g => g.name).join(' • ') : 'نامشخص';
        const cast = tv.credits?.cast?.slice(0, 8).map(c => c.name).join(' • ') || 'نامشخص';
        const creator = tv.created_by?.map(c => c.name).join(' • ') || 'نامشخص';
        const cleanTitle = tv.original_name || tv.name;

        const content = `
          <div class="section">
            <h1 style="font-size:34px;margin-bottom:8px">${tv.name}</h1>
            <p style="color:#aaa;margin-bottom:20px;font-size:17px">${tv.original_name} (${tv.first_air_date ? tv.first_air_date.split('-')[0] : ''})</p>

            <div class="info-grid">
              <div class="info-item"><div class="info-label">⭐ امتیاز</div><div class="info-value">${tv.vote_average.toFixed(1)} / 10</div></div>
              <div class="info-item"><div class="info-label">📅 اولین پخش</div><div class="info-value">${tv.first_air_date || 'نامشخص'}</div></div>
              <div class="info-item"><div class="info-label">🎭 ژانر</div><div class="info-value">${genres}</div></div>
              <div class="info-item"><div class="info-label">📺 تعداد فصل</div><div class="info-value">${tv.number_of_seasons || 0} فصل</div></div>
            </div>

            <div style="margin-top:28px"><h3>📝 خلاصه داستان</h3><p style="margin-top:10px;line-height:1.8;color:#ddd">${tv.overview || 'خلاصه‌ای ثبت نشده است.'}</p></div>

            <div style="margin-top:28px"><h3>🎭 عوامل سریال</h3><div class="info-grid" style="margin-top:12px"><div class="info-item"><div class="info-label">✍️ سازنده</div><div class="info-value">${creator}</div></div><div class="info-item"><div class="info-label">👥 بازیگران اصلی</div><div class="info-value">${cast}</div></div></div></div>

            <h3 style="margin-top:45px">🎬 پخش آنلاین و دانلود (قسمت به قسمت)</h3>
            <div style="background:#1f1f2e;padding:22px;border-radius:14px">${seasonsHtml || '<p>اطلاعات قسمت‌ها در دسترس نیست.</p>'}</div>

            <div class="video-container" id="player-container" style="margin-top:18px;display:none"><iframe id="episode-player" frameborder="0" allowfullscreen></iframe></div>

            <h3 style="margin-top:45px">📥 دانلود کل سریال (چند منبع)</h3>
            <div class="download-sources">
              <a href="https://www.f2mc.top/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">f2mc.top</a>
              <a href="https://digimovie.vip/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">Digimovie</a>
              <a href="https://www.f2m.top/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">f2m.top</a>
              <a href="https://www.film2movie.asia/?s=${encodeURIComponent(cleanTitle)}" target="_blank" class="source-btn">Film2Movie</a>
            </div>
          </div>

          <script>
            function playEpisode(embedUrl, btn) {
              document.querySelectorAll('.episode-btn').forEach(b => b.style.background = '#2a2a3e');
              btn.style.background = '#e50914';
              const container = document.getElementById('player-container');
              const iframe = document.getElementById('episode-player');
              iframe.src = embedUrl;
              container.style.display = 'block';
              container.scrollIntoView({ behavior: 'smooth' });
            }
            async function downloadEpisode(episodeTitle, originalName, btn) {
              const originalText = btn.innerHTML;
              btn.innerHTML = '⏳ در حال جستجو...';
              btn.disabled = true;
              try {
                const res = await fetch('/api/get-download?title=' + encodeURIComponent(episodeTitle) + '&original=' + encodeURIComponent(originalName || '') + '&quality=');
                const data = await res.json();
                if (data.success && data.link) window.open(data.link, '_blank');
                else window.open('https://www.f2mc.top/?s=' + encodeURIComponent(episodeTitle), '_blank');
              } catch(e) {
                window.open('https://www.f2mc.top/?s=' + encodeURIComponent(episodeTitle), '_blank');
              }
              btn.innerHTML = originalText;
              btn.disabled = false;
            }
          </script>
        `;
        return new Response(generateHTML(content), { headers: { "Content-Type": "text/html;charset=UTF-8" } });
      }

      // ==================== API دانلود ====================
      if (path.startsWith("/api/get-download")) {
        const title = searchParams.get("title");
        const original = searchParams.get("original") || "";
        const quality = searchParams.get("quality") || "";

        if (!title) return new Response(JSON.stringify({ success: false }), { headers: { "Content-Type": "application/json" } });

        const result = await searchDownloadLink(title, original, quality);

        if (result && result.link) {
          return new Response(JSON.stringify({ success: true, link: result.link, source: result.source }), {
            headers: { "Content-Type": "application/json" }
          });
        } else {
          return new Response(JSON.stringify({ success: false }), {
            headers: { "Content-Type": "application/json" }
          });
        }
      }

      return new Response("صفحه یافت نشد", { status: 404 });

    } catch (error) {
      return new Response(`<html><body style="background:#0f0f1a;color:white;text-align:center;padding:50px"><h1>خطا</h1><p>${error.message}</p></body></html>`, { status: 500 });
    }
  }
};
